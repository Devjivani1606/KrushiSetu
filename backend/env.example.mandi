# ============================================================
# .env.example - Copy to .env and fill in your values
# ============================================================
# NEVER commit .env to Git. Add .env to .gitignore.

# Server
PORT=5000

# Database (PostgreSQL)
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=your_db_name
DB_PASSWORD=your_db_password
DB_PORT=5432

# OpenWeather API (for weather feature)
OPENWEATHER_API_KEY=your_openweather_api_key

# Data.gov.in API (for Mandi Price / Agmarknet)
# Get your key from: https://data.gov.in → My Account → API Key
API_KEY=your_generated_api_key_here

# Optional: Use api.data.gov.in format instead of data.gov.in India OGD
# Set to 'true' if your API key works with api.data.gov.in
# USE_API_DATA_GOV=false
